// 03 — Password Spray Hunt
// Platform: Azure Data Explorer
// Purpose: identify IPs producing failed authentication across many accounts.
// Maps to MITRE ATT&CK T1110.003 — Password Spraying.

SigninLogs_CL
| where ResultType == 50126
| where TimeGenerated between (ago(7d) .. now())
| summarize
    FailedAttempts = count(),
    DistinctUsers = dcount(UserPrincipalName),
    TargetedUsers = make_set(UserPrincipalName, 20)
  by IPAddress, bin(TimeGenerated, 1h)
| where FailedAttempts >= 20 and DistinctUsers >= 5
| order by TimeGenerated asc
